5.38 0 0 1 -5.33 5.43z"></path> <path d="m25.2 53.13a5.4 5.4 0 1 1 5.4-5.4 5.44 5.44 0 0 1 -5.4 5.4z"></path> <path d="m47.9 52.33a5.4 5.4 0 1 1 5.4-5.4 5.32 5.32 0 0 1 -5.24 5.4z"></path> </g> </svg> </button>  <!--?lit$385569392$--><div role="dialog" aria-modal="true" id="1bd9012a-eece-4abb-8b41-f248fe1049c6" aria-labelledby="1bd9012a-eece-4abb-8b41-f248fe1049c6__label" aria-hidden="true" class=" osano-cm-window__info-dialog osano-cm-info-dialog osano-cm-info-dialog--hidden "> <!--?lit$385569392$--><!--?lit$385569392$--><span tabindex="0" aria-hidden="true" data-focus="first"></span><!--?--> <div role="presentation" class=" osano-cm-info-dialog__info osano-cm-info osano-cm-info--position_right "> <!--?lit$385569392$--><div role="presentation" class=" osano-cm-info__info-dialog-header osano-cm-info-dialog-header "> <p role="heading" aria-level="1" id="1bd9012a-eece-4abb-8b41-f248fe1049c6__label" class=" osano-cm-info-dialog-header__header osano-cm-header "> <!--?lit$385569392$--> </p> <!--?lit$385569392$--> <button class=" osano-cm-info-dialog-header__close osano-cm-close "> <!--?lit$385569392$--><svg width="20px" height="20px" viewBox="0 0 20 20" role="img" aria-labelledby="5188ce80-8107-4462-a1ce-eef2c0cc38f3"> <title id="5188ce80-8107-4462-a1ce-eef2c0cc38f3"><!---->Fechar preferências de cookie<!----></title> <line role="presentation" x1="2" y1="2" x2="18" y2="18"></line> <line role="presentation" x1="2" y1="18" x2="18" y2="2"></line> </svg> </button> <!--?lit$385569392$--> </div> <div role="presentation" class=" osano-cm-info__info-views osano-cm-info-views osano-cm-info-views--hidden osano-cm-info-views--position_0 "> <!--?lit$385569392$--> </div> </div> <!--?lit$385569392$--><!--?lit$385569392$--><span tabindex="0" aria-hidden="true" data-focus="last"></span><!--?--> </div> </div><script defer="" type="application/javascript">window.__initialState = JSON.parse("{\"__locale\":\"pt-BR\",\"__assetPath\":\"https://s-f.scribdassets.com/\"}");</script><div id="fb-root" class=" fb_reset"><script type="text/javascript">Scribd.Facebook.setup();</script><script type="text/javascript" src="./Scribd_files/sdk(1).js.download" async=""></script><div style="position: absolute; top: -10000px; width: 0px; height: 0px;"><div></div></div></div><div class="auto__embeds_new_show view_mode_scroll" id="autogen_id_606103575" data-track_category="embeds"><div class="document_scroller"><div class="document_container"><script type="text/javascript">DocumentManager.scrollParent = document.querySelector(".document_scroller")</script><script type="text/javascript">
