utilação\",\"sexual_offenses\":\"Ofensas sexuais\",\"sexually_explicit\":\"Sexualmente explícito\",\"shocking_or_disturbing\":\"Chocante ou perturbador\",\"spreading_false_information\":\"Divulgação de informações falsas\",\"terrorism\":\"Terrorismo\",\"threatening_behavior\":\"Comportamento ameaçador\",\"violent_offenses\":\"Ofensas violentas\"},\"subcategory_error_flash\":\"Selecione uma subcategoria para enviar seu relatório\",\"title\":\"Denunciar conteúdo\",\"type\":{\"dangerous_and_derogatory\":\"Perigoso e depreciativo\",\"dangerous_and_derogatory_tooltip\":\"Conteúdo que incentiva comportamentos prejudiciais, ameaçadores ou de ódio.\",\"deceptive_and_fraudulent\":\"Enganoso e fraudulento\",\"deceptive_and_fraudulent_tooltip\":\"Conteúdo que intencionalmente engana, ilude ou envolve atividades fraudulentas.\",\"explicit\":\"Explícito\",\"explicit_tooltip\":\"Conteúdo gráfico, ofensivo ou perturbador.\",\"illegal\":\"Ilegal\",\"illegal_tooltip\":\"Conteúdo que infringe a lei ou promove atividades ilegais.\",\"low_quality\":\"Baixa qualidade\",\"low_quality_tooltip\":\"Conteúdo que não atende aos padrões mínimos de clareza, relevância ou integridade.\",\"privacy\":\"Privacidade\",\"privacy_tooltip\":\"Conteúdo que faz uso indevido de informações pessoais.\",\"spam\":\"Spam\",\"spam_tooltip\":\"Conteúdo não solicitado e repetitivo que atrapalha sua experiência.\"}},\"share_drawer\":{\"copy_link\":\"Copiar link\"},\"doc_search\":{\"use_advanced_find_right_now\":\"Use Localização Avançada agora mesmo com um teste grátis\"},\"ai_actions\":{\"define_this_text\":\"Defina os termos deste texto\",\"explain_this_text\":\"Explique este texto\",\"page_num\":\"Página {{pageNum}}\",\"summarize_this_text\":\"Resuma este texto\"},\"doc_chat_additional_feedback\":{\"heading\":\"Fornecer feedback adicional\",\"placeholder\":\"Qual é a sua opinião sobre a resposta? Como ela poderia ser aprimorada?\"},\"doc_chat_disclaimer\":\"Este recurso é fornecido pela OpenAI e pode cometer e